# Copy this file to .env and add your own Groq API key. Never commit .env.
GROQ_API_KEY=

# Use /home/filingscope.db on Azure App Service with persistent app storage enabled.
DATABASE_PATH=./filingscope.db

# Optional: configure Azure Blob Storage to keep uploaded PDFs off the app filesystem.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=filingscope-documents
